usage: review.py prepare [-h] --repo REPO --base BASE --task TASK
                         --output OUTPUT [--spec SPEC]
                         [--spec-section SPEC_SECTION]
                         [--spec-reference SPEC_REFERENCE] [--exclude EXCLUDE]
                         [--include-archive]

options:
  -h, --help            show this help message and exit
  --repo REPO
  --base BASE
  --task TASK
  --output OUTPUT
  --spec SPEC           Mandatory whole-file requirement
  --spec-section SPEC_SECTION
                        Required excerpt: path::Full heading > Subheading
  --spec-reference SPEC_REFERENCE
                        Optional reference: path::Full heading > Subheading
  --exclude EXCLUDE     Exclude a relative file or directory; recorded as an
                        unreviewed limitation
  --include-archive     Allow explicitly selected archived requirements; does
                        not load the whole archive
