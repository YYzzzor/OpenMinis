{
  "description": "OpenMinis model delegation and patch-role checks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(spawn_agent|Agent|collaboration\\.spawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/harness/pre_tool_use_policy.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/harness/pre_tool_use_policy.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
