DEFINE SCHEMA

    RECORD TYPE CompactMarkerV2 (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "boundaryMessageId" STRING,
        "compactedCount" INT64,
        "createdAt" TIMESTAMP QUERYABLE SORTABLE,
        "firstKeptMessageId" STRING,
        "firstKeptSortOrder" INT64,
        "lastCompactedMessageId" STRING,
        "markerId" STRING,
        "markerVersion" INT64,
        "sessionId" STRING QUERYABLE,
        "summary" STRING,
        "syncMinimumCompatibleVersion" INT64,
        "syncSchemaVersion" INT64,
        "uiBoundarySortOrder" INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE EnvVarItem (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
